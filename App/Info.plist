    <string>LocalFlow controls Spotify only when you use a spoken Spotify command to search, play, pause, resume, skip, or go back.</string>
    <key>NSHumanReadableCopyright</key>
    <string>LocalFlow is free, open-source software.</string>
    <key>ATSApplicationFontsPath</key>
    <string>Fonts</string>
    <key>SUEnableAutomaticChecks</key>
    <false/>
